    "dichvuright-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "dichvuright.ai",
      "options": {
        "baseURL": "${OPENCODE_API_BASE_URL}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol (bri got scammed)",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 1000000
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "low": {
              "reasoningEffort": "low",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          }
        }
      }
    },
    "agentrouter-openai": {
      "name": "AgentRouter",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "${OPENCODE_API_BASE_URL}",
        "apiKey": "${OPENCODE_API_KEY}"
