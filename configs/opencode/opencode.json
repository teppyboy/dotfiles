{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@franlol/opencode-md-table-formatter@latest",
    "opencode-background-agents@latest",
    "opencode-pty@latest",
    "opencode-vibeguard@latest",
    "@plannotator/opencode@latest",
    "@dietrichgebert/ponytail",
    "${OPENCODE_LOCAL_PLUGIN_PATH}"
  ],
  "mcp": {
    "chrome-devtools-mcp": {
      "type": "local",
      "command": [
        "pnpx",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "${OPENCODE_API_BASE_URL}",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "${OPENCODE_API_BASE_URL}",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "${OPENCODE_API_BASE_URL}",
      "enabled": true
    },
    "headroom": {
      "type": "local",
      "command": [
        "${OPENCODE_HEADROOM_COMMAND}",
        "mcp",
        "serve"
      ],
      "enabled": true
    }
  },
  "provider": {
    "ds2api": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek (DS2API)",
      "options": {
        "baseURL": "${OPENCODE_API_BASE_URL}",
        "apiKey": "${OPENCODE_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek: V4 Flash",
          "limit": {
            "context": 1048576,
            "output": 393216
          }
        },
        "deepseek-v4-flash-nothinking": {
          "name": "DeepSeek: V4 Flash No Thinking",
